#include <layout_shift.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&tog_ls { layout-maps = <&layout_shift_map_us_to_jis>; };

&tog_ls_on { layout-maps = <&layout_shift_map_us_to_jis>; };

&tog_ls_off { layout-maps = <&layout_shift_map_us_to_jis>; };

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        // Define these after all includes: Keymap Editor may reorder includes.
        // Keep the standard key-press device for ZMK core components.
        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // Override &kp here so US-to-JIS conversion survives include sorting.
        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC        &kp Q  &kp W  &kp E  &kp R         &kp T                                             &kp Y      &kp U      &kp I      &kp O    &kp P     &kp PIPE
&mt LCTRL TAB  &kp A  &kp S  &kp D  &kp F         &kp G                                             &kp H      &kp J      &kp K      &kp L    &kp SEMI  &kp DOUBLE_QUOTES
&kp LSHFT      &kp Z  &kp X  &kp C  &kp V         &kp B             &kp F15        &kp PRINTSCREEN  &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp TILDE
                                    &kp LEFT_WIN  &mt LEFT_ALT F14  &lt 1 SPACE    &lt 2 ENTER      &lt 3 F13  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp ESCAPE      &none  &kp LC(RIGHT)  &none      &none         &none                                     &kp LC(C)  &kp LC(Z)  &none             &none              &kp LC(V)  &kp DELETE
&mt LCTRL TAB   &none  &none          &kp LC(X)  &none         &none                                     &kp LEFT   &kp DOWN   &kp UP            &kp RIGHT          &kp MINUS  &kp PLUS
&kp LEFT_SHIFT  &none  &kp DELETE     &none      &none         &kp LC(LEFT)  &none        &none          &none      &none      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none      &none
                                                 &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE    &kp BACKSPACE  &trans     &kp RCTRL
            >;
        };

        layer_2 {
            bindings = <
&kp ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                &kp NUMBER_6  &kp N7     &kp N8  &kp N9  &kp N0        &kp BACKSPACE
&mt LCTRL TAB   &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                                &kp F6        &kp F7     &kp F8  &kp F9  &kp F10       &none
&kp LEFT_SHIFT  &kp F11       &kp F12       &kp F13       &kp F14       &kp F15       &none        &trans     &none         &trans     &kp LT  &kp GT  &kp QUESTION  &none
                                                          &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE    &kp ENTER  &none         &kp RCTRL
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR    &kp PERCENT                           &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&mt LCTRL TAB   &trans           &trans       &trans    &trans        &trans                                &kp HOME   &kp PAGE_DOWN  &kp PG_UP     &kp END               &trans                 &trans
&kp LEFT_SHIFT  &trans           &trans       &trans    &trans        &trans        &trans       &mo 4      &trans     &trans         &trans        &trans                &trans                 &trans
                                                        &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE    &kp ENTER  &none      &kp RCTRL
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &tog_ls_on  &tog_ls_off  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans                          &trans      &trans       &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans      &trans       &trans  &trans  &trans  &trans
                                                          &trans        &trans        &trans    &trans  &trans      &trans
            >;
        };
    };
};
